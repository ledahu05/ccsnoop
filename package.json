{
  "name": "ccsnoop",
  "version": "0.1.0",
  "description": "Snoop raw Claude Code ↔ Anthropic traffic — capture proxy with report, fine-tune, and cache-economy diagnostics",
  "type": "module",
  "bin": {
    "ccsnoop": "bin/ccsnoop.js"
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "data"
  ],
  "scripts": {
    "start": "node bin/ccsnoop.js start",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "sandcastle": "npx tsx .sandcastle/main.ts",
    "sandcastle:opus": "SANDCASTLE_PROFILE=opus npx tsx .sandcastle/main.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
